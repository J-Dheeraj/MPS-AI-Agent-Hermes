# .env.example — MPS Hermes Agent
# Copy to ~/mps-hermes/.env and fill in your values.
# Never commit a filled .env file to git.

# ---------------------------------------------------------------------------
# CRM Bridge backend
# ---------------------------------------------------------------------------

# Which backend to use: sqlite | google_sheets | rest_api | sharepoint | csv
CRM_BACKEND=sqlite

# Where CRM data files live
CRM_DATA_DIR=~/mps-hermes/crm-data

# SQLite (default — works with no extra setup)
CRM_SQLITE_FILE=mps-cases.db

# ---------------------------------------------------------------------------
# Google Sheets (if using google_sheets backend)
# ---------------------------------------------------------------------------

# CRM_GSHEET_ID=<your-spreadsheet-id-from-the-URL>
# CRM_GSHEET_CREDENTIALS=~/mps-hermes/crm-data/gsheet-credentials.json

# ---------------------------------------------------------------------------
# REST API (if using rest_api backend)
# ---------------------------------------------------------------------------

# CRM_REST_BASE_URL=https://your-crm-system.example.com/api/v1
# CRM_REST_API_KEY=your-api-key-here
# CRM_REST_API_HEADER=X-API-Key

# ---------------------------------------------------------------------------
# SharePoint (if using sharepoint backend)
# ---------------------------------------------------------------------------

# CRM_SP_SITE_URL=https://yourorg.sharepoint.com/sites/MPS
# CRM_SP_CLIENT_ID=<app-registration-client-id>
# CRM_SP_CLIENT_SECRET=<app-registration-client-secret>
# CRM_SP_LIST_NAME=MPS Cases

# ---------------------------------------------------------------------------
# MCP HTTP transport port (optional — for HTTP mode instead of stdio)
# ---------------------------------------------------------------------------

# MCP_PORT=8000
